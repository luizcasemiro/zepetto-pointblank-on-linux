+/***********************************************************************
+ *           tls_block_alloc / tls_block_free
+ *
+ * Windows guarantees that the per-module TLS data block (the one stored in
+ * TEB->ThreadLocalStoragePointer[index]) is 16-byte aligned; some binaries
+ * rely on it and use SSE instructions on the block.  The 32-bit Wine heap
+ * only aligns to BLOCK_ALIGN == 2*sizeof(void*) == 8, so allocate a bit more
+ * and keep the raw pointer in the word right before the aligned block.  Every
+ * free path must go through tls_block_free() to recover that raw pointer.
+ */
+#define TLS_BLOCK_ALIGN 16
+
+static void *tls_block_alloc( SIZE_T size )
+{
+    void *raw, *ptr;
+
+    if (!(raw = RtlAllocateHeap( GetProcessHeap(), 0,
+                                 size + TLS_BLOCK_ALIGN + sizeof(void *) ))) return NULL;
+    ptr = (void *)(((ULONG_PTR)raw + sizeof(void *) + TLS_BLOCK_ALIGN - 1) &
+                   ~(ULONG_PTR)(TLS_BLOCK_ALIGN - 1));
+    ((void **)ptr)[-1] = raw;
+    TRACE( "tls block raw %p -> aligned %p (mod16 %lu)\n", raw, ptr, (ULONG)((ULONG_PTR)ptr & 15) );
+    return ptr;
+}
+
+static void tls_block_free( void *ptr )
+{
+    if (!ptr) return;
+    RtlFreeHeap( GetProcessHeap(), 0, ((void **)ptr)[-1] );
+}
+
 /*************************************************************************
  *		alloc_tls_slot
  *
